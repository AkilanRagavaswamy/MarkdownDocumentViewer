<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MarkdownViewer.App.Views.DocumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MarkdownViewer.Core.ViewModels"
    xmlns:behaviors="using:MarkdownViewer.App.Behaviors"
    xmlns:cv="using:MarkdownViewer.App.Converters"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Outline pane -->
        <Grid
            x:Name="OutlinePane"
            Grid.Column="0"
            Width="236"
            Padding="8,4,8,8"
            AutomationProperties.LandmarkType="Navigation"
            AutomationProperties.Name="Outline"
            Visibility="{x:Bind IsOutlineVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Padding="12,4,0,8">
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.HeadingLevel="Level2"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Outline" />
                <Button
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="Collapse all to H2 (Ctrl+Shift+[)"
                    Command="{x:Bind Shell.CollapseAllCommand, Mode=OneTime}"
                    Style="{StaticResource SubtleIconButtonStyle}"
                    ToolTipService.ToolTip="Collapse all to H2 (Ctrl+Shift+[)">
                    <FontIcon FontSize="12" Glyph="&#xE96D;" />
                </Button>
            </Grid>

            <TreeView
                x:Name="OutlineTree"
                Grid.Row="1"
                behaviors:TreeViewInvokeCommand.Command="{x:Bind ViewModel.NavigateToHeadingCommand, Mode=OneWay}"
                AutomationProperties.Name="Document outline"
                CanDragItems="False"
                CanReorderItems="False"
                ItemsSource="{x:Bind ViewModel.Outline, Mode=OneWay}"
                SelectionMode="None">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="vm:OutlineItemViewModel">
                        <TreeViewItem
                            AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                            ItemsSource="{x:Bind Children, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">
                            <Grid Height="28" Margin="-4,0,0,0">
                                <Border
                                    Background="{ThemeResource MdvAccentTintBrush}"
                                    CornerRadius="4"
                                    Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <Rectangle
                                    Width="3"
                                    Height="14"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    RadiusX="1.5"
                                    RadiusY="1.5"
                                    Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock
                                    Margin="10,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="{x:Bind cv:BindingFunctions.HeadingWeight(IsCurrent, Level), Mode=OneWay}"
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </TreeViewItem>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

        <!-- Reading card -->
        <Grid
            x:Name="ReadingCard"
            Grid.Column="1"
            Background="{ThemeResource MdvReadingBackgroundBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,1,0,0"
            CornerRadius="8,0,0,0">

            <!-- Top inset keeps the WebView clear of the rounded corner; it is the same colour as the page. -->
            <WebView2
                x:Name="Web"
                Margin="0,8,0,0"
                AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}" />

            <ProgressBar
                VerticalAlignment="Top"
                IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel
                MaxWidth="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind cv:BindingFunctions.VisibleIfTextAndEmpty(ViewModel.ErrorMessage, ViewModel.Html), Mode=OneWay}">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="32"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Glyph="&#xE783;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Couldn't open this file" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.ReloadCommand, Mode=OneWay}"
                    Content="Try again" />
            </StackPanel>

            <!-- Non-fatal errors (e.g. a link that could not be opened) while the document stays visible. -->
            <InfoBar
                Margin="12,12,12,0"
                VerticalAlignment="Top"
                IsClosable="True"
                IsOpen="{x:Bind cv:BindingFunctions.HasTextAndContent(ViewModel.ErrorMessage, ViewModel.Html), Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Warning" />

            <!-- Find bar overlay -->
            <Border
                x:Name="FindBar"
                Margin="0,12,20,0"
                Padding="6"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Translation="0,0,32"
                Visibility="{x:Bind ViewModel.IsFindOpen, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel
                    AutomationProperties.LandmarkType="Search"
                    AutomationProperties.Name="Find in document"
                    Orientation="Horizontal"
                    Spacing="4">
                    <TextBox
                        x:Name="FindBox"
                        Width="200"
                        AutomationProperties.Name="Find in document"
                        KeyboardAcceleratorPlacementMode="Hidden"
                        PlaceholderText="Find in document"
                        Text="{x:Bind ViewModel.FindQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.KeyboardAccelerators>
                            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.FindNextCommand, Mode=OneWay}" Key="Enter" />
                            <KeyboardAccelerator
                                behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.FindPreviousCommand, Mode=OneWay}"
                                Key="Enter"
                                Modifiers="Shift" />
                        </TextBox.KeyboardAccelerators>
                    </TextBox>
                    <TextBlock
                        MinWidth="48"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.FindStatus, Mode=OneWay}"
                        TextAlignment="Center" />
                    <Button
                        AutomationProperties.Name="Previous match (Shift+F3)"
                        Command="{x:Bind ViewModel.FindPreviousCommand, Mode=OneWay}"
                        Style="{StaticResource SubtleIconButtonStyle}"
                        ToolTipService.ToolTip="Previous match (Shift+F3)">
                        <FontIcon FontSize="12" Glyph="&#xE70E;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Next match (F3)"
                        Command="{x:Bind ViewModel.FindNextCommand, Mode=OneWay}"
                        Style="{StaticResource SubtleIconButtonStyle}"
                        ToolTipService.ToolTip="Next match (F3)">
                        <FontIcon FontSize="12" Glyph="&#xE70D;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Close find (Esc)"
                        Command="{x:Bind ViewModel.CloseFindCommand, Mode=OneWay}"
                        Style="{StaticResource SubtleIconButtonStyle}"
                        ToolTipService.ToolTip="Close find (Esc)">
                        <FontIcon FontSize="10" Glyph="&#xE711;" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
