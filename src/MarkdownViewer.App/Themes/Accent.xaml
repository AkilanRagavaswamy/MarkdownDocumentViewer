            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#B2000000" />
            <SolidColorBrush x:Key="AppBarToggleButtonBackgroundChecked" Color="#FF343A54" />
            <SolidColorBrush x:Key="AppBarToggleButtonBackgroundCheckedPointerOver" Color="#FF343A54" />
            <SolidColorBrush x:Key="AppBarToggleButtonBackgroundCheckedPressed" Color="#FF343A54" />
            <SolidColorBrush x:Key="AppBarToggleButtonForegroundChecked" Color="#FF6C81E9" />
            <SolidColorBrush x:Key="AppBarToggleButtonForegroundCheckedPointerOver" Color="#FF6C81E9" />
            <SolidColorBrush x:Key="AppBarToggleButtonForegroundCheckedPressed" Color="#FF6C81E9" />
            <SolidColorBrush x:Key="MdvAccentFillBrush" Color="#FF546DE5" />
            <SolidColorBrush x:Key="MdvAccentTextBrush" Color="#FF6C81E9" />
            <SolidColorBrush x:Key="MdvAccentTintBrush" Color="#FF343A54" />
            <SolidColorBrush x:Key="MdvAccentMarkBrush" Color="#FF303862" />
            <SolidColorBrush x:Key="MdvReadingBackgroundBrush" Color="#FF1C1C1C" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
