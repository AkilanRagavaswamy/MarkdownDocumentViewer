<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MarkdownViewer.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="using:MarkdownViewer.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Must stay after XamlControlsResources so the accent brushes override the defaults. -->
                <ResourceDictionary Source="ms-appx:///Themes/Accent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <cv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <cv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <cv:PathToBreadcrumbConverter x:Key="PathToBreadcrumb" />
            <cv:IdentityConverter x:Key="Identity" />
            <cv:BoolToFontWeightConverter x:Key="BoolToFontWeight" />
            <cv:StringToVisibilityConverter x:Key="StringToVisibility" />

            <!-- Shared styles -->
            <Style x:Key="TitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="SubtleIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <Style x:Key="StatusTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
