<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MarkdownViewer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MarkdownViewer.Core.ViewModels"
    xmlns:views="using:MarkdownViewer.App.Views"
    xmlns:behaviors="using:MarkdownViewer.App.Behaviors"
    xmlns:cv="using:MarkdownViewer.App.Converters"
    xmlns:helpers="using:MarkdownViewer.App.Helpers"
    mc:Ignorable="d"
    Title="Markdown Viewer - Simple">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        behaviors:FileDropBehavior.Target="{x:Bind ViewModel, Mode=OneTime}"
        Background="Transparent">

        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <!-- Selected tab blends into the CommandBar layer below it. -->
                    <!-- Values match LayerFillColorDefault in each theme. -->
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#80FFFFFF" />
                        <SolidColorBrush x:Key="TabViewBackground" Color="Transparent" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#4C3A3A3A" />
                        <SolidColorBrush x:Key="TabViewBackground" Color="Transparent" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>

                <Style x:Key="ToolbarDropDownStyle" TargetType="DropDownButton">
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Margin" Value="4,0" />
                    <Setter Property="Padding" Value="10,0,8,0" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>

                <!-- Collapsed labels: 48 keeps the glyph pitch the same as the CommandBar overflow button. -->
                <Style x:Key="ToolbarIconButtonStyle" TargetType="AppBarButton">
                    <Setter Property="Width" Value="48" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <!--
            Every shortcut from ShortcutCatalog that maps to a MainViewModel command.
            Keep in sync with MarkdownViewer.Core.Services.ShortcutCatalog (shown in the Shortcuts dialog).
        -->
        <Grid.KeyboardAccelerators>
            <!-- Files & tabs -->
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.OpenFileCommand, Mode=OneTime}" Key="O" Modifiers="Control" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.OpenFolderCommand, Mode=OneTime}" Key="O" Modifiers="Control,Shift" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.CloseTabCommand, Mode=OneTime}" Key="W" Modifiers="Control" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.ReopenClosedTabCommand, Mode=OneTime}" Key="T" Modifiers="Control,Shift" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.NextTabCommand, Mode=OneTime}" Key="Tab" Modifiers="Control" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.PreviousTabCommand, Mode=OneTime}" Key="Tab" Modifiers="Control,Shift" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.PrintCommand, Mode=OneTime}" Key="P" Modifiers="Control" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.ExportPdfCommand, Mode=OneTime}" Key="E" Modifiers="Control,Shift" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.EditExternallyCommand, Mode=OneTime}" Key="E" Modifiers="Control" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.CopyFilePathCommand, Mode=OneTime}" Key="C" Modifiers="Control,Shift" />

            <!-- Reading -->
            <KeyboardAccelerator
                behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.SetDensityCommand, Mode=OneTime}"
                behaviors:AcceleratorCommand.CommandParameter="{x:Bind helpers:XamlValues.Comfortable, Mode=OneTime}"
                Key="Number1"
                Modifiers="Control" />
            <KeyboardAccelerator
                behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.SetDensityCommand, Mode=OneTime}"
                behaviors:AcceleratorCommand.CommandParameter="{x:Bind helpers:XamlValues.Compact, Mode=OneTime}"
                Key="Number2"
                Modifiers="Control" />
            <KeyboardAccelerator
                behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.SetDensityCommand, Mode=OneTime}"
                behaviors:AcceleratorCommand.CommandParameter="{x:Bind helpers:XamlValues.Ultra, Mode=OneTime}"
                Key="Number3"
                Modifiers="Control" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.ZoomInCommand, Mode=OneTime}" Key="{x:Bind helpers:XamlValues.OemPlus, Mode=OneTime}" Modifiers="Control" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.ZoomInCommand, Mode=OneTime}" Key="Add" Modifiers="Control" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.ZoomOutCommand, Mode=OneTime}" Key="{x:Bind helpers:XamlValues.OemMinus, Mode=OneTime}" Modifiers="Control" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.ZoomOutCommand, Mode=OneTime}" Key="Subtract" Modifiers="Control" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.ResetZoomCommand, Mode=OneTime}" Key="Number0" Modifiers="Control" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.ResetZoomCommand, Mode=OneTime}" Key="NumberPad0" Modifiers="Control" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.ToggleOutlineCommand, Mode=OneTime}" Key="B" Modifiers="Control" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.ToggleFocusModeCommand, Mode=OneTime}" Key="F11" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.ToggleSourceCommand, Mode=OneTime}" Key="U" Modifiers="Control" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.ToggleThemeCommand, Mode=OneTime}" Key="D" Modifiers="Control,Shift" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.CollapseAllCommand, Mode=OneTime}" Key="{x:Bind helpers:XamlValues.OemOpenBracket, Mode=OneTime}" Modifiers="Control,Shift" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.ExpandAllCommand, Mode=OneTime}" Key="{x:Bind helpers:XamlValues.OemCloseBracket, Mode=OneTime}" Modifiers="Control,Shift" />

            <!-- Navigation -->
            <KeyboardAccelerator Key="G" Invoked="OnFocusOutlineInvoked" Modifiers="Control" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.GoBackCommand, Mode=OneTime}" Key="Left" Modifiers="Menu" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.GoForwardCommand, Mode=OneTime}" Key="Right" Modifiers="Menu" />

            <!-- Find -->
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.OpenFindCommand, Mode=OneTime}" Key="F" Modifiers="Control" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.FindNextCommand, Mode=OneTime}" Key="F3" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.FindPreviousCommand, Mode=OneTime}" Key="F3" Modifiers="Shift" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.EscapeCommand, Mode=OneTime}" Key="Escape" />

            <!-- App -->
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.OpenSettingsCommand, Mode=OneTime}" Key="{x:Bind helpers:XamlValues.OemComma, Mode=OneTime}" Modifiers="Control" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.ShowShortcutsCommand, Mode=OneTime}" Key="{x:Bind helpers:XamlValues.OemSlash, Mode=OneTime}" Modifiers="Control" />
            <KeyboardAccelerator behaviors:AcceleratorCommand.Command="{x:Bind ViewModel.ShowShortcutsCommand, Mode=OneTime}" Key="F1" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================== Row 0: title bar ============================== -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Interactive, so TitleBarHelper registers this panel as a passthrough region. -->
            <StackPanel
                x:Name="TitleBarLeading"
                Grid.Column="1"
                Margin="8,0,4,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    AutomationProperties.Name="About Markdown Viewer - Simple"
                    Command="{x:Bind ViewModel.ShowAboutCommand, Mode=OneTime}"
                    Style="{StaticResource SubtleIconButtonStyle}"
                    ToolTipService.ToolTip="About Markdown Viewer - Simple">
                    <Image
                        Width="20"
                        Height="20"
                        AutomationProperties.AccessibilityView="Raw"
                        Source="ms-appx:///Assets/Square44x44Logo.targetsize-24_altform-unplated.png" />
                </Button>
                <Button
                    AutomationProperties.Name="Home"
                    Command="{x:Bind ViewModel.GoHomeCommand, Mode=OneTime}"
                    Style="{StaticResource SubtleIconButtonStyle}"
                    ToolTipService.ToolTip="Home — the open-file screen">
                    <FontIcon FontSize="14" Glyph="&#xE80F;" />
                </Button>
            </StackPanel>

            <!-- Bottom-aligned so tabs meet the CommandBar. Height matches the Standard caption height, which
                 is what the title-bar row is; the tab template is sized to it in TabView.Resources below. -->
            <TabView Padding="0"
                x:Name="DocumentTabs"
                Grid.Column="2"
                Height="32"
                VerticalAlignment="Bottom"
                behaviors:TabCloseCommand.Command="{x:Bind ViewModel.CloseTabCommand, Mode=OneTime}"
                AddTabButtonCommand="{x:Bind ViewModel.OpenFileCommand, Mode=OneTime}"
                AutomationProperties.Name="Open documents"
                Tapped="OnTabStripTapped"
                IsAddTabButtonVisible="{x:Bind ViewModel.HasTabs, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}"
                TabItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}"
                TabWidthMode="Equal">
                <TabView.TabItemTemplate>
                    <DataTemplate x:DataType="vm:DocumentTabViewModel">
                        <!-- Default tabs are 40px tall and the 32px title bar would clip them. -->
                        <TabViewItem
                            Height="32"
                            MinHeight="0"
                            AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                            Header="{x:Bind Title, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind FilePath, Mode=OneWay}">
                            <TabViewItem.IconSource>
                                <FontIconSource Glyph="&#xE8A5;" />
                            </TabViewItem.IconSource>
                        </TabViewItem>
                    </DataTemplate>
                </TabView.TabItemTemplate>
                <TabView.TabStripFooter>
                    <!-- Caption (drag) region: fills the space between the tabs and the title-bar buttons. -->
                    <Grid
                        x:Name="DragRegion"
                        MinWidth="48"
                        Background="Transparent" />
                </TabView.TabStripFooter>
            </TabView>

            <StackPanel
                x:Name="TitleBarButtons"
                Grid.Column="3"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <Button
                    AutomationProperties.Name="Switch light or dark theme (Ctrl+Shift+D)"
                    Command="{x:Bind ViewModel.ToggleThemeCommand, Mode=OneTime}"
                    Style="{StaticResource TitleBarButtonStyle}"
                    ToolTipService.ToolTip="Switch light or dark theme (Ctrl+Shift+D)">
                    <Grid>
                        <!-- Moon in light theme, sun in dark theme. -->
                        <FontIcon
                            FontSize="16"
                            Glyph="&#xE708;"
                            Visibility="{x:Bind cv:BindingFunctions.CollapsedIf(ViewModel.IsDarkTheme), Mode=OneWay}" />
                        <FontIcon
                            FontSize="16"
                            Glyph="&#xE706;"
                            Visibility="{x:Bind cv:BindingFunctions.VisibleIf(ViewModel.IsDarkTheme), Mode=OneWay}" />
                    </Grid>
                </Button>
                <Button
                    AutomationProperties.Name="Keyboard shortcuts (Ctrl+/)"
                    Command="{x:Bind ViewModel.ShowShortcutsCommand, Mode=OneTime}"
                    Style="{StaticResource TitleBarButtonStyle}"
                    ToolTipService.ToolTip="Keyboard shortcuts (Ctrl+/)">
                    <FontIcon FontSize="16" Glyph="&#xE765;" />
                </Button>
                <Button
                    AutomationProperties.Name="Settings (Ctrl+,)"
                    Command="{x:Bind ViewModel.OpenSettingsCommand, Mode=OneTime}"
                    Style="{StaticResource TitleBarButtonStyle}"
                    ToolTipService.ToolTip="Settings (Ctrl+,)">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                </Button>
                <Rectangle
                    Width="1"
                    Height="16"
                    Margin="4,8,4,0"
                    VerticalAlignment="Top"
                    Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
            </StackPanel>
        </Grid>

        <!-- ============================== Row 1: CommandBar ============================== -->
        <Border Margin="0,0,0,0"
            Grid.Row="1"
            MinHeight="44"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Visibility="{x:Bind cv:BindingFunctions.VisibleIfNeither(ViewModel.IsFocusMode, ViewModel.IsSettingsOpen), Mode=OneWay}">
            <CommandBar
                Padding="4,0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Center"
                AutomationProperties.Name="Document commands"
                Background="Transparent"
                DefaultLabelPosition="Collapsed"
                IsDynamicOverflowEnabled="True">

                <CommandBar.Content>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <AppBarToggleButton BorderBrush="Transparent"
                                AutomationProperties.Name="Toggle outline (Ctrl+B)"
                                Command="{x:Bind ViewModel.ToggleOutlineCommand, Mode=OneTime}"
                                IsChecked="{x:Bind ViewModel.IsOutlinePaneOpen, Mode=OneWay}"
                                Label="Outline"
                                LabelPosition="Collapsed"
                                ToolTipService.ToolTip="Toggle outline (Ctrl+B)">
                                <AppBarToggleButton.Icon>
                                    <FontIcon Glyph="&#xE8A0;" />
                                </AppBarToggleButton.Icon>
                            </AppBarToggleButton>
                            <AppBarButton
                                AutomationProperties.Name="Back (Alt+Left)"
                                Command="{x:Bind ViewModel.GoBackCommand, Mode=OneTime}"
                                Label="Back"
                                LabelPosition="Collapsed"
                                ToolTipService.ToolTip="Back (Alt+Left)">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE72B;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton
                                AutomationProperties.Name="Forward (Alt+Right)"
                                Command="{x:Bind ViewModel.GoForwardCommand, Mode=OneTime}"
                                Label="Forward"
                                LabelPosition="Collapsed"
                                ToolTipService.ToolTip="Forward (Alt+Right)">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE72A;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </StackPanel>

                        <Rectangle
                            Grid.Column="1"
                            Width="1"
                            Height="20"
                            Margin="6,0"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <BreadcrumbBar
                            Grid.Column="2"
                            Margin="4,0,8,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="File location"
                            ItemsSource="{x:Bind cv:BindingFunctions.Breadcrumb(ViewModel.SelectedFilePath), Mode=OneWay}"
                            Visibility="{x:Bind cv:BindingFunctions.VisibleIf(ViewModel.HasTabs), Mode=OneWay}">
                            <BreadcrumbBar.ItemTemplate>
                                <!-- BreadcrumbBar runs the template bindings once with a null item for its own
                                     ellipsis entry, and x:Bind generates a cast that throws on null, so bind classically. -->
                                <DataTemplate>
                                    <BreadcrumbBarItem AutomationProperties.Name="{Binding}">
                                        <TextBlock FontSize="12" Text="{Binding}" />
                                    </BreadcrumbBarItem>
                                </DataTemplate>
                            </BreadcrumbBar.ItemTemplate>
                        </BreadcrumbBar>
                    </Grid>
                </CommandBar.Content>

                <!-- Density -->
                <AppBarElementContainer VerticalContentAlignment="Center" IsTabStop="False">
                    <DropDownButton
                        AutomationProperties.Name="Reading density"
                        Style="{StaticResource ToolbarDropDownStyle}"
                        ToolTipService.ToolTip="Reading density (Ctrl+1 / Ctrl+2 / Ctrl+3)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8FD;" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.DensityLabel, Mode=OneWay}" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <RadioMenuFlyoutItem
                                    Command="{x:Bind ViewModel.SetDensityCommand, Mode=OneTime}"
                                    CommandParameter="{x:Bind helpers:XamlValues.Comfortable, Mode=OneTime}"
                                    GroupName="Density"
                                    IsChecked="{x:Bind cv:BindingFunctions.IsComfortable(ViewModel.Density), Mode=OneWay}"
                                    KeyboardAcceleratorTextOverride="Ctrl+1"
                                    Text="Comfortable" />
                                <RadioMenuFlyoutItem
                                    Command="{x:Bind ViewModel.SetDensityCommand, Mode=OneTime}"
                                    CommandParameter="{x:Bind helpers:XamlValues.Compact, Mode=OneTime}"
                                    GroupName="Density"
                                    IsChecked="{x:Bind cv:BindingFunctions.IsCompact(ViewModel.Density), Mode=OneWay}"
                                    KeyboardAcceleratorTextOverride="Ctrl+2"
                                    Text="Compact" />
                                <RadioMenuFlyoutItem
                                    Command="{x:Bind ViewModel.SetDensityCommand, Mode=OneTime}"
                                    CommandParameter="{x:Bind helpers:XamlValues.Ultra, Mode=OneTime}"
                                    GroupName="Density"
                                    IsChecked="{x:Bind cv:BindingFunctions.IsUltra(ViewModel.Density), Mode=OneWay}"
                                    KeyboardAcceleratorTextOverride="Ctrl+3"
                                    Text="Ultra" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </AppBarElementContainer>

                <!-- Columns -->
                <AppBarElementContainer VerticalContentAlignment="Center" IsTabStop="False">
                    <DropDownButton
                        AutomationProperties.Name="Columns"
                        Content="{x:Bind ViewModel.ColumnsLabel, Mode=OneWay}"
                        Style="{StaticResource ToolbarDropDownStyle}"
                        ToolTipService.ToolTip="Columns">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <RadioMenuFlyoutItem
                                    Command="{x:Bind ViewModel.SetColumnsCommand, Mode=OneTime}"
                                    CommandParameter="{x:Bind helpers:XamlValues.ColumnsAuto, Mode=OneTime}"
                                    GroupName="Columns"
                                    IsChecked="{x:Bind cv:BindingFunctions.IsColumnsAuto(ViewModel.ColumnMode), Mode=OneWay}"
                                    Text="Auto (fit window width)" />
                                <RadioMenuFlyoutItem
                                    Command="{x:Bind ViewModel.SetColumnsCommand, Mode=OneTime}"
                                    CommandParameter="{x:Bind helpers:XamlValues.ColumnsOne, Mode=OneTime}"
                                    GroupName="Columns"
                                    IsChecked="{x:Bind cv:BindingFunctions.IsColumnsOne(ViewModel.ColumnMode), Mode=OneWay}"
                                    Text="1 column" />
                                <RadioMenuFlyoutItem
                                    Command="{x:Bind ViewModel.SetColumnsCommand, Mode=OneTime}"
                                    CommandParameter="{x:Bind helpers:XamlValues.ColumnsTwo, Mode=OneTime}"
                                    GroupName="Columns"
                                    IsChecked="{x:Bind cv:BindingFunctions.IsColumnsTwo(ViewModel.ColumnMode), Mode=OneWay}"
                                    Text="2 columns" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </AppBarElementContainer>

                <!-- Zoom -->
                <AppBarElementContainer VerticalContentAlignment="Center" IsTabStop="False">
                    <Border
                        Height="32"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <Button
                                AutomationProperties.Name="Zoom out (Ctrl+Minus)"
                                Command="{x:Bind ViewModel.ZoomOutCommand, Mode=OneTime}"
                                Style="{StaticResource SubtleIconButtonStyle}" CornerRadius="0"
                                ToolTipService.ToolTip="Zoom out (Ctrl+Minus)">
                                <FontIcon FontSize="12" Glyph="&#xE738;" />
                            </Button>
                            <Button
                                Width="48"
                                Height="30"
                                Padding="0"
                                CornerRadius="0"
                                AutomationProperties.Name="Reset zoom (Ctrl+0)"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.ResetZoomCommand, Mode=OneTime}"
                                Content="{x:Bind ViewModel.ZoomLabel, Mode=OneWay}"
                                FontSize="12"
                                ToolTipService.ToolTip="Reset zoom (Ctrl+0)" />
                            <Button
                                AutomationProperties.Name="Zoom in (Ctrl+Plus)"
                                Command="{x:Bind ViewModel.ZoomInCommand, Mode=OneTime}"
                                Style="{StaticResource SubtleIconButtonStyle}"
                                CornerRadius="0"
                                ToolTipService.ToolTip="Zoom in (Ctrl+Plus)">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                            </Button>
                        </StackPanel>
                    </Border>
                </AppBarElementContainer>

                <AppBarSeparator />

                <AppBarButton
                    AutomationProperties.Name="Find (Ctrl+F)"
                    Command="{x:Bind ViewModel.OpenFindCommand, Mode=OneTime}"
                    KeyboardAcceleratorTextOverride="Ctrl+F"
                    Label="Find"
                    Style="{StaticResource ToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="Find (Ctrl+F)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    AutomationProperties.Name="Focus mode (F11)"
                    Command="{x:Bind ViewModel.ToggleFocusModeCommand, Mode=OneTime}"
                    KeyboardAcceleratorTextOverride="F11"
                    Label="Focus mode"
                    Style="{StaticResource ToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="Focus mode (F11)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE740;" />
                    </AppBarButton.Icon>
                </AppBarButton>

                <!-- "More" (overflow) -->
                <CommandBar.SecondaryCommands>
                    <AppBarButton
                        Command="{x:Bind ViewModel.PrintCommand, Mode=OneTime}"
                        KeyboardAcceleratorTextOverride="Ctrl+P"
                        Label="Print">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE749;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        Command="{x:Bind ViewModel.ExportPdfCommand, Mode=OneTime}"
                        KeyboardAcceleratorTextOverride="Ctrl+Shift+E"
                        Label="Export PDF">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xEA90;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarToggleButton
                        Command="{x:Bind ViewModel.ToggleSourceCommand, Mode=OneTime}"
                        IsChecked="{x:Bind ViewModel.SelectedTab.ShowSource, Mode=OneWay}"
                        KeyboardAcceleratorTextOverride="Ctrl+U"
                        Label="View source">
                        <AppBarToggleButton.Icon>
                            <FontIcon Glyph="&#xE943;" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <AppBarSeparator />
                    <AppBarButton
                        Command="{x:Bind ViewModel.CopyFilePathCommand, Mode=OneTime}"
                        KeyboardAcceleratorTextOverride="Ctrl+Shift+C"
                        Label="Copy path">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8C8;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        Command="{x:Bind ViewModel.EditExternallyCommand, Mode=OneTime}"
                        KeyboardAcceleratorTextOverride="Ctrl+E"
                        Label="Edit in…">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE70F;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        Command="{x:Bind ViewModel.OpenFolderCommand, Mode=OneTime}"
                        KeyboardAcceleratorTextOverride="Ctrl+Shift+O"
                        Label="Open folder">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE838;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Border>

        <!-- ============================== Row 2: default-app InfoBar ============================== -->
        <InfoBar
            Grid.Row="2"
            Margin="8,8,8,0"
            CloseButtonCommand="{x:Bind ViewModel.DismissBannerCommand, Mode=OneTime}"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.IsBannerVisible, Mode=OneWay}"
            Message="Windows asks you to confirm in Settings."
            Severity="Informational"
            Title="Make Markdown Viewer - Simple your default for .md files">
            <InfoBar.ActionButton>
                <Button
                    Command="{x:Bind ViewModel.OpenDefaultAppsCommand, Mode=OneTime}"
                    Content="Open Default apps"
                    Style="{StaticResource AccentButtonStyle}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- ============================== Row 3: content ============================== -->
        <Grid Grid.Row="3" Padding="0,8,0,0">
            <views:DocumentView
                x:Name="DocView"
                IsOutlineVisible="{x:Bind ViewModel.IsOutlinePaneOpen, Mode=OneWay}"
                ViewModel="{x:Bind ViewModel.SelectedTab, Mode=OneWay}"
                Visibility="{x:Bind cv:BindingFunctions.VisibleIf(ViewModel.IsDocumentVisible), Mode=OneWay}" />

            <!-- Empty state -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind cv:BindingFunctions.VisibleIf(ViewModel.IsStartScreenVisible), Mode=OneWay}">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="48"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE8A5;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="No document open" />
                <Button
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Open a Markdown file (Ctrl+O)"
                    Command="{x:Bind ViewModel.OpenFileCommand, Mode=OneTime}"
                    Content="Open a Markdown file"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Open a Markdown file (Ctrl+O)" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="or drop a .md file here" />
                <HyperlinkButton
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Open folder (Ctrl+Shift+O)"
                    Command="{x:Bind ViewModel.OpenFolderCommand, Mode=OneTime}"
                    Content="Open folder…"
                    ToolTipService.ToolTip="Open folder (Ctrl+Shift+O)" />
            </StackPanel>

            <!-- Settings page (Agent 4's SettingsPage navigated into this frame once at startup) -->
            <Frame
                x:Name="SettingsFrame"
                Visibility="{x:Bind cv:BindingFunctions.VisibleIf(ViewModel.IsSettingsOpen), Mode=OneWay}" />
        </Grid>

        <!-- ============================== Row 4: status bar ============================== -->
        <Grid
            Grid.Row="4"
            Height="28"
            Padding="16,0"
            AutomationProperties.LandmarkType="Custom"
            AutomationProperties.LocalizedLandmarkType="Status bar"
            Background="{ThemeResource MdvReadingBackgroundBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{x:Bind cv:BindingFunctions.VisibleIf(ViewModel.IsDocumentVisible), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Style="{StaticResource StatusTextStyle}" Visibility="{x:Bind cv:BindingFunctions.VisibleIfText(ViewModel.SelectedTab.CurrentSectionTitle), Mode=OneWay}">
                    <Run Text="Section: " /><Run Text="{x:Bind ViewModel.SelectedTab.CurrentSectionTitle, Mode=OneWay, FallbackValue=''}" />
                </TextBlock>
                <TextBlock Style="{StaticResource StatusTextStyle}" Text="{x:Bind ViewModel.SelectedTab.StatsText, Mode=OneWay, FallbackValue=''}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="16">
                <TextBlock
                    AutomationProperties.Name="Encoding"
                    Style="{StaticResource StatusTextStyle}"
                    Text="{x:Bind ViewModel.SelectedTab.EncodingLabel, Mode=OneWay, FallbackValue=''}" />
                <TextBlock
                    AutomationProperties.Name="Line endings"
                    Style="{StaticResource StatusTextStyle}"
                    Text="{x:Bind ViewModel.SelectedTab.LineEndingLabel, Mode=OneWay, FallbackValue=''}" />
                <TextBlock
                    AutomationProperties.Name="Density"
                    Style="{StaticResource StatusTextStyle}"
                    Text="{x:Bind ViewModel.DensityLabel, Mode=OneWay}" />
                <TextBlock Style="{StaticResource StatusTextStyle}" Text="Live reload on" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
